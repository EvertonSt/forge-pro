{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ALLOW_DEMO_MODE", "NODE_ENV", "SUPABASE_URL", "SUPABASE_ANON_KEY", "SUPABASE_SERVICE_ROLE_KEY", "NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "//": "Once real env vars land (ANTHROPIC_API_KEY, STRIPE_*, SUPABASE_*, SANITY_*), add them under globalEnv so Turbo never serves a cache produced against stale secrets."
}
