---
/* ProductCard.astro — product card with add-to-cart */
interface Props {
  name: string;
  price: number;
  originalPrice?: number;
  category: string;
  emoji: string;
  rating?: number;
  reviews?: number;
  slug: string;
}
const { name, price, originalPrice, category, emoji, rating = 5, reviews = 12, slug } = Astro.props;
const discount = originalPrice ? Math.round((1 - price / originalPrice) * 100) : 0;
---
<article class="product-card">
  <a href={`/product/${slug}`} class="product-card__link" aria-label={`View ${name}`}>
    <div class="product-card__img">
      <span class="product-card__emoji">{emoji}</span>
      {discount > 0 && <span class="product-card__badge badge--sale">-{discount}%</span>}
    </div>
  </a>
  <div class="product-card__info">
    <div class="product-card__category">{category}</div>
    <a href={`/product/${slug}`} class="product-card__name">{name}</a>
    <div class="product-card__rating">
      {'★'.repeat(rating)}{'☆'.repeat(5 - rating)}
      <span class="product-card__reviews">({reviews})</span>
    </div>
    <div class="product-card__price">
      <span class="product-card__current">${price.toFixed(2)}</span>
      {originalPrice && <span class="product-card__original">${originalPrice.toFixed(2)}</span>}
    </div>
    <button class="btn btn--primary btn--sm product-card__add" data-product={JSON.stringify({ name, price, emoji, slug })} aria-label={`Add ${name} to cart`}>
      Add to Cart
    </button>
  </div>
</article>

<style>
  .product-card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; transition: all 0.3s var(--ease); }
  .product-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .product-card__link { display: block; }
  .product-card__img { aspect-ratio: 1; background: var(--bg-secondary); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .product-card__emoji { font-size: 4rem; transition: transform 0.3s var(--ease); }
  .product-card:hover .product-card__emoji { transform: scale(1.1); }
  .product-card__badge { position: absolute; top: 0.75rem; left: 0.75rem; background: var(--danger); color: #fff; font-size: 0.6875rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  .product-card__info { padding: 1rem; }
  .product-card__category { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.375rem; }
  .product-card__name { display: block; font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.375rem; line-height: 1.3; }
  .product-card__rating { font-size: 0.75rem; color: #f59e0b; margin-bottom: 0.5rem; }
  .product-card__reviews { color: var(--text-muted); }
  .product-card__price { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.75rem; }
  .product-card__current { font-size: 1.125rem; font-weight: 700; }
  .product-card__original { font-size: 0.8125rem; color: var(--text-muted); text-decoration: line-through; }
  .product-card__add { width: 100%; }
</style>

<script>
  document.querySelectorAll('.product-card__add').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const data = JSON.parse((btn as HTMLElement).dataset.product || '{}');
      const cart = JSON.parse(localStorage.getItem('lumen-cart') || '[]');
      const existing = cart.find((i: any) => i.name === data.name);
      if (existing) { existing.qty += 1; }
      else { cart.push({ ...data, qty: 1, variant: 'Default' }); }
      localStorage.setItem('lumen-cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      (btn as HTMLElement).textContent = '✓ Added';
      setTimeout(() => { (btn as HTMLElement).textContent = 'Add to Cart'; }, 1500);
    });
  });
</script>
