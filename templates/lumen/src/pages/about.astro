---
/* About page — Lumen brand story */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---
<Layout title="About">
  <Nav />
  <main id="main">
    <section class="about section">
      <div class="container container--narrow">
        <h1 class="about__title">Our Story</h1>
        <p class="about__lead">We believe great design should be accessible to everyone. Lumen was born from a simple idea: curate the best products for modern living, and deliver them with care.</p>

        <div class="about__values">
          <div class="about__value">
            <div class="about__value-icon">🎯</div>
            <h3>Curated Quality</h3>
            <p>Every product in our catalog is personally vetted by our team. We test, use, and love what we sell — because we'd never offer you anything we wouldn't use ourselves.</p>
          </div>
          <div class="about__value">
            <div class="about__value-icon">🌍</div>
            <h3>Sustainable Focus</h3>
            <p>We partner with brands committed to responsible manufacturing. From recycled packaging to ethically sourced materials, sustainability is woven into every decision.</p>
          </div>
          <div class="about__value">
            <div class="about__value-icon">🤝</div>
            <h3>Customer First</h3>
            <p>Free returns within 30 days, responsive support, and a no-questions-asked satisfaction guarantee. Your happiness is our metric.</p>
          </div>
        </div>

        <div class="about__numbers">
          <div class="about__number"><strong>10,000+</strong><span>Happy customers</span></div>
          <div class="about__number"><strong>50+</strong><span>Partner brands</span></div>
          <div class="about__number"><strong>4.9★</strong><span>Average rating</span></div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container--narrow { max-width: 48rem; }
  .about__title { font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem); margin-bottom: 1.5rem; }
  .about__lead { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.8; margin-bottom: 3rem; }
  .about__values { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  .about__value { padding: 1.5rem; border-radius: var(--radius-xl); border: 1px solid var(--border); }
  .about__value-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .about__value h3 { font-size: 1rem; margin-bottom: 0.5rem; }
  .about__value p { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.7; }
  .about__numbers { display: flex; justify-content: center; gap: 3rem; padding: 2rem; background: var(--bg-secondary); border-radius: var(--radius-xl); text-align: center; }
  .about__number strong { display: block; font-size: 1.5rem; font-weight: 800; }
  .about__number span { font-size: 0.8125rem; color: var(--text-secondary); }
</style>
