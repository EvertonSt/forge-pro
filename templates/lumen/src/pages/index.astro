---
/* index.astro — Lumen e-commerce homepage */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductCard from '../components/ProductCard.astro';

const products = [
  { name: 'Meridian Desk Lamp', price: 89, originalPrice: 129, category: 'Lighting', emoji: '💡', slug: 'meridian-lamp', rating: 5, reviews: 48 },
  { name: 'Atlas Standing Desk', price: 449, category: 'Furniture', emoji: '🪑', slug: 'atlas-desk', rating: 4, reviews: 32 },
  { name: 'Vela Wireless Charger', price: 39, originalPrice: 59, category: 'Tech', emoji: '⚡', slug: 'vela-charger', rating: 5, reviews: 127 },
  { name: 'Cirrus Noise Canceller', price: 199, category: 'Audio', emoji: '🎧', slug: 'cirrus-headphones', rating: 5, reviews: 89 },
  { name: 'Nomad Laptop Sleeve', price: 49, category: 'Accessories', emoji: '💼', slug: 'nomad-sleeve', rating: 4, reviews: 56 },
  { name: 'Pulse Fitness Band', price: 79, originalPrice: 99, category: 'Wearables', emoji: '⌚', slug: 'pulse-band', rating: 4, reviews: 203 },
  { name: 'Terra Plant Pot', price: 34, category: 'Home', emoji: '🪴', slug: 'terra-pot', rating: 5, reviews: 41 },
  { name: 'Zen Meditation Cushion', price: 59, category: 'Wellness', emoji: '🧘', slug: 'zen-cushion', rating: 5, reviews: 67 },
];

const categories = [
  { name: 'Furniture', emoji: '🪑', count: 24 },
  { name: 'Lighting', emoji: '💡', count: 18 },
  { name: 'Tech', emoji: '⚡', count: 31 },
  { name: 'Audio', emoji: '🎧', count: 15 },
  { name: 'Accessories', emoji: '💼', count: 22 },
  { name: 'Home', emoji: '🪴', count: 19 },
];

const reviews = [
  { name: 'Sarah M.', text: 'The Atlas desk completely transformed my home office. Build quality is incredible.', rating: 5, product: 'Atlas Standing Desk' },
  { name: 'James K.', text: 'Best headphones I\'ve owned. The noise cancellation is studio-quality.', rating: 5, product: 'Cirrus Noise Canceller' },
  { name: 'Elena R.', text: 'Beautiful design, fast shipping. The lamp is even prettier in person.', rating: 5, product: 'Meridian Desk Lamp' },
];
---
<Layout title="Lumen" jsonLd={{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Lumen",
  "url": "https://lumen-template.example.com",
  "potentialAction": { "@type": "SearchAction", "target": "https://lumen-template.example.com/search?q={search_term_string}" }
}}>
  <Nav />
  <CartDrawer />

  <main id="main">
    <!-- Hero -->
    <section class="hero section">
      <div class="container hero__inner">
        <div class="hero__content animate-in">
          <span class="hero__tag">✦ New Collection</span>
          <h1 class="hero__title">Design your<br/>perfect space</h1>
          <p class="hero__subtitle">Premium products curated for modern living. Free shipping on orders over $99.</p>
          <div class="hero__actions">
            <a href="#products" class="btn btn--primary btn--lg">Shop Now</a>
            <a href="/about" class="btn btn--secondary btn--lg">Our Story</a>
          </div>
        </div>
        <div class="hero__visual" aria-hidden="true">
          <div class="hero__shape hero__shape--1">🪑</div>
          <div class="hero__shape hero__shape--2">💡</div>
          <div class="hero__shape hero__shape--3">🎧</div>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="categories section">
      <div class="container">
        <h2 class="section-title">Browse by Category</h2>
        <div class="categories__grid">
          {categories.map(cat => (
            <a href="#products" class="categories__card">
              <span class="categories__emoji">{cat.emoji}</span>
              <span class="categories__name">{cat.name}</span>
              <span class="categories__count">{cat.count} products</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Products -->
    <section class="products section" id="products">
      <div class="container">
        <div class="products__header">
          <h2 class="section-title">Featured Products</h2>
          <div class="products__filters">
            <button class="products__filter active">All</button>
            <button class="products__filter">Furniture</button>
            <button class="products__filter">Tech</button>
            <button class="products__filter">Home</button>
          </div>
        </div>
        <div class="products__grid">
          {products.map(p => <ProductCard {...p} />)}
        </div>
      </div>
    </section>

    <!-- Reviews -->
    <section class="reviews section" id="reviews">
      <div class="container container--narrow">
        <h2 class="section-title" style="text-align:center">What Our Customers Say</h2>
        <div class="reviews__grid">
          {reviews.map(r => (
            <div class="reviews__card">
              <div class="reviews__stars">{'★'.repeat(r.rating)}</div>
              <p class="reviews__text">"{r.text}"</p>
              <div class="reviews__author">
                <div class="reviews__avatar">{r.name[0]}</div>
                <div>
                  <div class="reviews__name">{r.name}</div>
                  <div class="reviews__product">{r.product}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="newsletter section">
      <div class="container container--narrow" style="text-align: center;">
        <h2 class="section-title">Stay in the Loop</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 28rem; margin-inline: auto;">Get early access to new products, exclusive offers, and design inspiration.</p>
        <form class="newsletter__form" onsubmit="event.preventDefault(); this.querySelector('button').textContent='✓ Subscribed'; this.querySelector('input').disabled=true;">
          <input type="email" class="input" placeholder="your@email.com" required style="max-width: 20rem;" />
          <button type="submit" class="btn btn--primary">Subscribe</button>
        </form>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer" role="contentinfo">
      <div class="container footer__inner">
        <div class="footer__brand">
          <div class="footer__logo">Lumen</div>
          <p class="footer__tagline">Premium products for modern living.</p>
        </div>
        <div class="footer__links">
          <div class="footer__col">
            <h4 class="footer__col-title">Shop</h4>
            <a href="#products">All Products</a>
            <a href="#products">New Arrivals</a>
            <a href="#products">Best Sellers</a>
            <a href="#products">Sale</a>
          </div>
          <div class="footer__col">
            <h4 class="footer__col-title">Company</h4>
            <a href="/about">About</a>
            <a href="#">Careers</a>
            <a href="#">Press</a>
            <a href="#">Contact</a>
          </div>
          <div class="footer__col">
            <h4 class="footer__col-title">Support</h4>
            <a href="#">Help Center</a>
            <a href="#">Shipping</a>
            <a href="#">Returns</a>
            <a href="#">Privacy</a>
          </div>
        </div>
      </div>
      <div class="container footer__bottom">
        <p>© 2026 Lumen. All rights reserved.</p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .section-title { font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem); margin-bottom: 1.5rem; }
  .container--narrow { max-width: 60rem; }

  /* Hero */
  .hero { overflow: hidden; position: relative; padding-top: clamp(5rem, 4rem + 4vw, 8rem); padding-bottom: clamp(3rem, 2rem + 4vw, 5rem); }
  .hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .hero__tag { display: inline-block; font-size: 0.8125rem; font-weight: 600; color: var(--accent); background: var(--accent-light); padding: 4px 12px; border-radius: 999px; margin-bottom: 1rem; }
  .hero__title { font-size: clamp(2.5rem, 2rem + 3vw, 3.75rem); font-weight: 800; letter-spacing: -0.025em; margin-bottom: 1rem; }
  .hero__subtitle { font-size: 1.0625rem; color: var(--text-secondary); max-width: 28rem; margin-bottom: 2rem; line-height: 1.7; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero__visual { position: relative; height: 24rem; }
  .hero__shape { position: absolute; border-radius: 1.5rem; display: flex; align-items: center; justify-content: center; background: var(--bg-secondary); box-shadow: var(--shadow-lg); }
  .hero__shape--1 { width: 10rem; height: 10rem; font-size: 3.5rem; top: 10%; left: 10%; animation: float 6s ease-in-out infinite; }
  .hero__shape--2 { width: 7rem; height: 7rem; font-size: 2.5rem; top: 5%; right: 15%; animation: float 6s ease-in-out infinite 2s; }
  .hero__shape--3 { width: 8rem; height: 8rem; font-size: 3rem; bottom: 10%; left: 30%; animation: float 6s ease-in-out infinite 4s; }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }

  /* Categories */
  .categories__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 1rem; }
  .categories__card { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 1.5rem 1rem; border-radius: var(--radius-xl); border: 1px solid var(--border); background: var(--bg); transition: all 0.3s var(--ease); text-align: center; }
  .categories__card:hover { border-color: var(--accent); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .categories__emoji { font-size: 2rem; }
  .categories__name { font-weight: 600; font-size: 0.875rem; }
  .categories__count { font-size: 0.75rem; color: var(--text-muted); }

  /* Products */
  .products__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .products__filters { display: flex; gap: 0.25rem; }
  .products__filter { padding: 0.375rem 1rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 500; color: var(--text-secondary); border: 1px solid var(--border); transition: all 0.15s var(--ease); }
  .products__filter:hover { border-color: var(--border-strong); }
  .products__filter.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .products__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr)); gap: 1.5rem; }

  /* Reviews */
  .reviews__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.5rem; }
  .reviews__card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 1.5rem; }
  .reviews__stars { color: #f59e0b; margin-bottom: 0.75rem; font-size: 0.875rem; }
  .reviews__text { font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1rem; font-style: italic; }
  .reviews__author { display: flex; align-items: center; gap: 0.75rem; }
  .reviews__avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8125rem; font-weight: 700; }
  .reviews__name { font-size: 0.8125rem; font-weight: 600; }
  .reviews__product { font-size: 0.75rem; color: var(--text-muted); }

  /* Newsletter */
  .newsletter { background: var(--bg-secondary); }
  .newsletter__form { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; width: 100%; }
  .newsletter__form .input { max-width: 20rem; flex: 1; min-width: 10rem; }

  /* Footer */
  .footer { border-top: 1px solid var(--border); padding-top: 3rem; padding-bottom: 1.5rem; }
  .footer__inner { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; margin-bottom: 2rem; }
  .footer__logo { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; }
  .footer__tagline { font-size: 0.875rem; color: var(--text-secondary); }
  .footer__links { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 1.5rem; }
  .footer__col { display: flex; flex-direction: column; gap: 0.5rem; }
  .footer__col-title { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
  .footer__col a { font-size: 0.875rem; color: var(--text-secondary); transition: color 0.15s; }
  .footer__col a:hover { color: var(--text); }
  .footer__bottom { border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.8125rem; color: var(--text-muted); }

  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { display: none; }
    .footer__inner { grid-template-columns: 1fr; }
  }
</style>
