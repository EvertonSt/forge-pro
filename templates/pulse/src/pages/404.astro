---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <div class="error-code">404</div>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or has been moved.</p>
        <div class="error-actions">
          <a href="/" class="btn btn-primary">Go Home</a>
          <a href="/blog" class="btn btn-outline">Browse the Blog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .error-code {
    font-family: var(--font-serif);
    font-size: clamp(6rem, 4rem + 8vw, 12rem);
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    opacity: 0.2;
    margin-bottom: var(--space-md);
  }
  .error-content h1 { margin-bottom: var(--space-sm); }
  .error-content p { color: var(--text-secondary); font-size: 1.1rem; margin-bottom: var(--space-xl); }
  .error-actions { display: flex; gap: var(--space-sm); justify-content: center; }
</style>
