---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <section style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div>
      <div style="font-family: var(--font-serif); font-size: clamp(6rem, 4rem + 8vw, 12rem); font-weight: 700; color: var(--accent); opacity: 0.2; line-height: 1;">404</div>
      <h1 style="margin-bottom: var(--space-sm);">Table Not Found</h1>
      <p style="color: var(--text-secondary); font-size: 1.05rem; margin-bottom: var(--space-xl);">This page doesn't exist, but our kitchen is always open.</p>
      <div style="display: flex; gap: var(--space-sm); justify-content: center;">
        <a href="/" class="btn btn-primary">Go Home</a>
        <a href="/#reservation" class="btn btn-outline">Reserve a Table</a>
      </div>
    </div>
  </section>
</Layout>
