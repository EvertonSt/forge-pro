---
/* Blog index — listing page */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'ai-code-review-best-practices',
    title: 'AI Code Review: Best Practices for 2026',
    excerpt: 'How to get the most out of AI-powered code review tools — and avoid common pitfalls.',
    date: '2026-01-15',
    readTime: '8 min',
    category: 'Engineering',
  },
  {
    slug: 'zero-downtime-deployments',
    title: 'Zero-Downtime Deployments Made Simple',
    excerpt: 'A practical guide to deploying with confidence using preview environments and automated rollbacks.',
    date: '2026-01-08',
    readTime: '6 min',
    category: 'DevOps',
  },
  {
    slug: 'scaling-engineering-teams',
    title: 'Scaling Engineering Teams: Lessons from 100+ Companies',
    excerpt: 'What we learned from helping over 100 engineering teams scale their workflows with automation.',
    date: '2025-12-20',
    readTime: '12 min',
    category: 'Leadership',
  },
];
---

<Layout title="Blog">
  <Nav />
  <main id="main">
    <section class="blog-hero section">
      <div class="container">
        <h1 class="blog-hero__title">Blog</h1>
        <p class="blog-hero__subtitle">Insights on engineering, DevOps, and building better software.</p>
      </div>
    </section>

    <section class="blog-list section" style="padding-top: 0;">
      <div class="container container--narrow">
        <div class="blog-grid">
          {posts.map(post => (
            <a href={`/blog/${post.slug}`} class="blog-card">
              <div class="blog-card__category">{post.category}</div>
              <h2 class="blog-card__title">{post.title}</h2>
              <p class="blog-card__excerpt">{post.excerpt}</p>
              <div class="blog-card__meta">
                <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                <span>·</span>
                <span>{post.readTime}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-hero { text-align: center; padding-bottom: 0; }
  .blog-hero__title { font-size: var(--text-5xl); margin-bottom: var(--space-4); }
  .blog-hero__subtitle { font-size: var(--text-lg); color: var(--text-secondary); }

  .blog-grid { display: flex; flex-direction: column; gap: var(--space-6); }
  .blog-card {
    display: block; padding: var(--space-8); border-radius: var(--radius-xl);
    border: 1px solid var(--border); background: var(--bg-secondary);
    transition: all var(--duration-slow) var(--ease);
  }
  .blog-card:hover {
    border-color: var(--accent); box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .blog-card__category {
    display: inline-block; font-size: var(--text-xs); font-weight: 600;
    color: var(--accent); background: var(--accent-light);
    padding: 4px 12px; border-radius: var(--radius-full); margin-bottom: var(--space-3);
  }
  .blog-card__title { font-size: var(--text-2xl); margin-bottom: var(--space-3); }
  .blog-card__excerpt {
    font-size: var(--text-base); color: var(--text-secondary);
    line-height: 1.7; margin-bottom: var(--space-4);
  }
  .blog-card__meta {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--text-tertiary);
  }
</style>
