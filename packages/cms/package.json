{
  "name": "@forge-pro/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "echo \"CMS tests land with the catalog logic.\""
  },
  "dependencies": {
    "@forge-pro/shared-types": "workspace:*",
    "@sanity/client": "^8.0.0",
    "sanity": "^6.9.0"
  },
  "devDependencies": {
    "@forge-pro/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
