---
import Layout from '../../layouts/Layout.astro';
import QaBadge from '../../components/QaBadge.astro';
import { formatPrice, getCatalog } from '../../lib/catalog';

export async function getStaticPaths() {
  const items = await getCatalog();
  return items.map((item) => ({
    params: { kind: item.kind, slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<Layout title={`${item.title} — Forge Pro`} description={item.description}>
  <a href="/templates" class="text-sm text-brand-600 hover:underline">← Back to catalog</a>

  <article class="mt-6 grid gap-10 lg:grid-cols-2">
    <section>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight">{item.title}</h1>
        <QaBadge badge={item.qaBadge} />
      </div>
      <p class="mt-4 text-neutral-600">{item.description}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {item.stack.map((tech) => (
          <span class="rounded-full border border-neutral-200 bg-white px-3 py-1 text-xs text-neutral-600">
            {tech}
          </span>
        ))}
      </div>

      {item.kind === 'template' && item.versions.length > 0 && (
        <div class="mt-8">
          <h2 class="text-lg font-semibold">Changelog</h2>
          <ul class="mt-3 space-y-3 text-sm text-neutral-600">
            {item.versions.map((v) => (
              <li class="flex gap-3">
                <span class="shrink-0 rounded border border-neutral-200 bg-neutral-100 px-2 py-0.5 font-mono text-xs">
                  {v.version}
                </span>
                <span>{v.notes ?? 'Updated'}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <aside class="h-fit rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
      <div class="flex items-baseline justify-between">
        <span class="text-sm text-neutral-600">{item.kind === 'template' ? 'Full template' : 'Component'}</span>
        <span class="text-2xl font-semibold">{formatPrice(item.price)}</span>
      </div>
      <p class="mt-2 text-xs text-neutral-400">
        One-time purchase · license included · free updates for this version
      </p>
      <div class="mt-6 space-y-3">
        <a
          href={item.previewUrl}
          target="_blank"
          class="block rounded-lg border border-neutral-300 px-4 py-2.5 text-center text-sm font-medium hover:bg-neutral-50"
        >
          Live preview
        </a>
        <button
          disabled
          class="block w-full cursor-not-allowed rounded-lg bg-neutral-200 px-4 py-2.5 text-center text-sm font-semibold text-neutral-500"
          title="Checkout arrives in Session 4"
        >
          Buy — checkout coming soon
        </button>
      </div>
      <p class="mt-4 text-xs text-neutral-400">
        Checkout, downloads, and your account dashboard land in Phase 1 (sessions 4–5).
      </p>
    </aside>
  </article>
</Layout>
