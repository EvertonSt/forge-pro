---
import type { CatalogItem } from '@forge-pro/shared-types';
import QaBadge from './QaBadge.astro';
import { formatPrice } from '../lib/catalog';

interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;
const href = `/${item.kind}/${item.slug}`;
---

<a
  href={href}
  class="group flex flex-col gap-3 rounded-lg border border-neutral-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold group-hover:text-brand-600">{item.title}</h3>
    <QaBadge badge={item.qaBadge} />
  </div>
  <p class="line-clamp-2 text-sm text-neutral-600">{item.description}</p>
  <div class="mt-auto flex items-center justify-between text-sm">
    <span class="font-medium">{formatPrice(item.price)}</span>
    <span class="text-neutral-400">
      {item.kind === 'template' ? item.framework : `${item.framework} · ${item.componentType}`}
    </span>
  </div>
</a>
