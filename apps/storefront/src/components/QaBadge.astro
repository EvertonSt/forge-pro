---
import type { QaBadge } from '@forge-pro/shared-types';

interface Props {
  badge: QaBadge;
}

const { badge } = Astro.props;

const styles: Record<QaBadge['status'], string> = {
  verified: 'border-success-500/30 bg-success-500/10 text-success-600',
  pending: 'border-neutral-200 bg-neutral-100 text-neutral-600',
  rejected: 'border-danger-500/30 bg-danger-500/10 text-danger-600',
  not_applicable: 'border-neutral-200 bg-neutral-100 text-neutral-400',
};

const labels: Record<QaBadge['status'], string> = {
  verified: 'QA verified',
  pending: 'QA pending',
  rejected: 'QA rejected',
  not_applicable: 'Not applicable',
};
---

<span class={`inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium ${styles[badge.status]}`}>
  <span class="inline-block h-1.5 w-1.5 rounded-full bg-current"></span>
  {badge.status === 'verified' && badge.compositeScore !== null
    ? `${labels[badge.status]} · ${badge.compositeScore}`
    : labels[badge.status]}
</span>
