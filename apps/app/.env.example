# All integrations are optional in the scaffold — the app builds and runs
# without any of these. Each unlocks a feature as the sessions land.

# Sanity (catalog reads)
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Supabase (auth, orders, licenses, QA records) — Session 4
# Migrations: supabase/migrations (see supabase/README.md)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret — session tokens are verified against this (jose, HS256).
# Once set (with SUPABASE_URL), the portal uses real auth and the demo store
# is bypassed; without them the dev stub/demo mode runs.
SUPABASE_JWT_SECRET=

# Stripe (checkout) — Session 4
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (AI Concierge) — Session 5
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-opus-4-1
ANTHROPIC_MODEL=

# Vendor portal (Phase 2)
# Shared secret the QA runner sends in x-forge-internal-secret on /api/qa/complete
APP_INTERNAL_SECRET=
# GitHub repository_dispatch target for the QA gate, e.g. EvertonSt/forge-pro
GITHUB_REPO=
GITHUB_TOKEN=
# Dev-mode identity for the portal auth stub (no Supabase env). Demo mode
# pins the demo vendor automatically; keep only if you need a custom id.
DEV_USER_ID=
# Run the portal's demo store against a production build (next start) — used
# by the Playwright e2e and for deployed demos. Never set alongside real
# Supabase credentials.
ALLOW_DEMO_MODE=0
